{
  "name": "buscapila",
  "version": "1.0.0",
  "private": true,
  "description": "buscaPila mobile application and API",
  "scripts": {
    "setup": "npm --prefix frontend ci && npm --prefix backend ci",
    "start": "npm run dev:frontend",
    "dev:frontend": "npm --prefix frontend start",
    "dev:backend": "npm --prefix backend run start:dev",
    "android": "npm --prefix frontend run android",
    "web": "npm --prefix frontend run web",
    "build:backend": "npm --prefix backend run build",
    "lint": "npm --prefix frontend run lint && npm --prefix backend run lint",
    "typecheck": "npm --prefix frontend run typecheck && npm --prefix backend run typecheck",
    "test:backend": "npm --prefix backend test",
    "test:e2e": "npm --prefix backend run test:e2e",
    "audit:frontend": "npm --prefix frontend audit",
    "audit:backend": "npm --prefix backend audit",
    "db:up": "docker compose --env-file backend/.env up -d --wait database",
    "db:stop": "docker compose --env-file backend/.env stop database",
    "db:status": "docker compose --env-file backend/.env ps database",
    "db:check": "npm --prefix backend run db:check"
  }
}
