PORT=3000
# Optional for Expo web development. Set this to the origin in the browser.
# WEB_ORIGIN=http://localhost:8081
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=buscapila
PGUSER=buscapila
# Use 48 random hexadecimal characters so Docker Compose and Node.js read the same password.
PGPASSWORD=
# Keep this stable. Generate 32 random bytes using the backend README command.
AUTH_ENCRYPTION_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
